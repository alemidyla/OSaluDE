    {
      "parameters": {
        "jsCode": "// Extrae CUIT y N° de afiliado y valida el dígito verificador del CUIT (módulo 11)\nconst PREFIJOS = ['20', '23', '24', '25', '26', '27', '30', '33', '34'];\nconst PESOS = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2];\nconst salida = [];\nconst entradas = $input.all();\nfor (let idx = 0; idx < entradas.length; idx++) {\n  const d = entradas[idx].json;\n  const texto = String(d.mensaje || '');\n  const m = texto.match(/\\b(\\d{2})[-. ]?(\\d{8})[-. ]?(\\d)\\b/);\n  let cuit = '';\n  let presente = false;\n  let valido = false;\n  if (m) {\n    presente = true;\n    cuit = m[1] + m[2] + m[3];\n    let suma = 0;\n    for (let i = 0; i < 10; i++) suma += Number(cuit[i]) * PESOS[i];\n    let dv = 11 - (suma % 11);\n    if (dv === 11) dv = 0;\n    valido = dv !== 10 && dv === Number(cuit[10]) && PREFIJOS.includes(m[1]);\n  }\n  const a = texto.match(/afiliad[oa][^0-9]{0,20}([0-9][0-9\\/-]{4,})/i);\n  salida.push({\n    json: {\n      ...d,\n      cuit_prestador: cuit,\n      cuit_presente: presente,\n      cuit_valido: valido,\n      numero_afiliado: a ? a[1] : '',\n    },\n    pairedItem: { item: idx },\n  });\n}\nreturn salida;"
      },
